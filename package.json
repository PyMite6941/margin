{
  "name": "margin",
  "version": "0.1.1",
  "private": true,
  "description": "A quiet text editor for the browser and the desktop that keeps your writing on your own machine.",
  "author": "PyMite6941",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "desktop:dev": "DEV_URL=http://localhost:5173 electron .",
    "package": "vite build && npx electron-builder"
  },
  "build": {
    "appId": "io.github.pymite6941.margin",
    "productName": "Margin",
    "files": [
      "dist",
      "desktop"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "nsis": {
      "artifactName": "${productName}-Setup.${ext}"
    }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "vite": "^8.3.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PyMite6941/margin.git"
  },
  "homepage": "https://pymite6941.github.io/margin/"
}
